{
  "name": "synapse",
  "version": "26.9.1",
  "packageManager": "pnpm@11.11.0",
  "description": "Synapse with Node.js",
  "main": "dist/app.js",
  "sideEffects": true,
  "scripts": {
    "check:imports": "node scripts/check-nested-imports.mjs",
    "start": "node dist/app.js",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node scripts/generate-admin-spa-paths.js && nodemon --watch src -e ts --exec ts-node src/app.ts",
    "dev:frontend": "cd frontend && npm run dev",
    "media-tool:serve": "ts-node src/mediaTool/standalone.ts",
    "media-tool:watch": "nodemon --watch src/mediaTool -e ts --exec ts-node src/mediaTool/standalone.ts",
    "build": "pnpm run build:backend && pnpm run build:frontend",
    "build:simple": "pnpm run build:backend && pnpm run build:frontend:simple",
    "build:minimal": "pnpm run build:backend && pnpm run build:frontend:minimal",
    "build:backend": "node scripts/generate-admin-spa-paths.js && tsc && node scripts/copy-templates.js && pnpm run obfuscate && node scripts/copy-obfuscated-payload.js",
    "build:backend:clean": "rm -rf dist dist-obfuscated && pnpm run build:backend",
    "obfuscate": "javascript-obfuscator dist --output dist-obfuscated --config package.json",
    "build:frontend": "cd frontend && pnpm install --frozen-lockfile --ignore-scripts && pnpm run build",
    "build:frontend:simple": "cd frontend && pnpm run build:simple",
    "build:frontend:minimal": "cd frontend && pnpm run build:minimal",
    "prod": "pnpm run build && pnpm start",
    "test": "jest --detectOpenHandles",
    "test:simple": "jest --detectOpenHandles --testPathPatterns=\"smartHumanCheckService|nonceStore|domainExemption\" --testNamePattern=\"should\" --verbose",
    "test:fix": "jest --detectOpenHandles --testPathPatterns=\"smartHumanCheckService\\.test\\.ts|nonceStore\\.test\\.ts|domainExemption\\.test\\.ts\" --testNamePattern=\"should\" --verbose --maxWorkers=1",
    "test:coverage": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch --detectOpenHandles",
    "test:verbose": "jest --verbose --detectOpenHandles",
    "test:auth": "jest --testPathPatterns=authController.test.ts",
    "test:db-init": "node scripts/tests/test-database-init.js",
    "test:performance": "jest performance.test.ts",
    "test:concurrency": "jest concurrency.test.ts",
    "test:ci": "jest --config jest.ci.config.js --ci --runInBand --coverage --reporters=default",
    "generate:openapi": "node scripts/generate-openapi.js",
    "generate:admin-spa-paths": "node scripts/generate-admin-spa-paths.js",
    "generate:privacy-data-map": "node scripts/generate-privacy-data-map.js",
    "generate:route-audit": "ts-node --transpile-only scripts/generate-route-audit.ts",
    "generate:cross-layer-report": "ts-node --transpile-only scripts/generate-route-audit.ts && echo 'Cross-layer report generated at docs/generated/cross-layer-compliance.md'",
    "migrate:tts-user-datas": "node scripts/migrations/migrate-tts-user-datas.js",
    "migrate:user-passwords": "ts-node --transpile-only scripts/migrations/migrate-user-passwords.ts",
    "migrate:admin-to-superadmin": "node scripts/migrations/migrate-admin-to-superadmin.js",
    "migrate:lumen-ttl": "node scripts/migrations/backfill-lumen-ttl.js",
    "migrate:mobile-token-lineage": "node scripts/migrations/backfill-mobile-token-lineage.js",
    "check:openapi-drift": "node scripts/governance/check-openapi-drift.js",
    "check:admin-spa-paths": "node scripts/generate-admin-spa-paths.js --check",
    "check:privacy-data-map": "node scripts/generate-privacy-data-map.js --check",
    "smoke:obfuscated": "node scripts/governance/smoke-obfuscated-artifact.js",
    "analyze:bundle": "pnpm run build:backend && pnpm run analyze:size",
    "analyze:size": "node -e \"const fs=require('fs');const path=require('path');const dir='dist';const files=fs.readdirSync(dir).filter(f=>f.endsWith('.js'));let total=0;files.forEach(f=>{const size=fs.statSync(path.join(dir,f)).size;total+=size;console.log(f+' '+Math.round(size/1024)+'KB')});console.log('Total: '+Math.round(total/1024)+'KB')\"",
    "analyze:full": "node scripts/analyze-bundle.js",
    "analyze:frontend": "cd frontend && pnpm run build:analyze",
    "analyze:backend": "pnpm run build:backend && pnpm run analyze:size",
    "profile:start": "node scripts/profiling/run-node-with-profiling.js",
    "profile:cpu": "node scripts/profiling/run-node-with-profiling.js --cpu",
    "profile:heap": "node scripts/profiling/run-node-with-profiling.js --heap",
    "profile:inspect": "node scripts/profiling/run-node-with-profiling.js --inspect",
    "profile:load": "node scripts/profiling/run-load-profile-report.js",
    "check:ts-file-size": "node scripts/governance/check-ts-file-size.js",
    "check:frontend-bundle": "node scripts/governance/check-frontend-bundle.js",
    "check:privacy-contract": "node scripts/governance/check-privacy-contract.js",
    "report:storage-responsibility": "node scripts/governance/report-storage-responsibility.js",
    "test:integration:mongo": "jest --config jest.integration.config.js --runInBand",
    "test:browser": "playwright test",
    "test:nightly": "pnpm run test:nightly:core && pnpm run test:nightly:external",
    "test:nightly:core": "jest --config jest.nightly.config.js --runInBand",
    "test:nightly:external": "jest --config jest.nightly.external.config.js --runInBand",
    "check:unused-deps": "npx depcheck",
    "check:tree-shaking": "pnpm run analyze:full && echo '检查完成，请查看上面的分析结果'",
    "check:tree-shaking-config": "node scripts/check-tree-shaking.js",
    "docker:build": "scripts/build-docker.sh",
    "docker:build:win": "scripts\\build-docker.bat",
    "docker:build:simple": "docker build --platform linux/amd64 --memory=4g --memory-swap=4g -t synapse:simple .",
    "docker:build:minimal": "docker build --platform linux/amd64 --memory=2g --memory-swap=2g -t synapse:minimal .",
    "check:audit-policies": "node scripts/check-audit-policies.js",
    "test:audit-policies": "node scripts/tests/test-audit-policies.js",
    "fix:security-alerts": "node scripts/fix-dependabot-alerts.js",
    "fix:dependabot-alerts": "node scripts/fix-dependabot-alerts.js --dependabot-only",
    "fix:codeql-alerts": "node scripts/fix-dependabot-alerts.js --codeql-only",
    "test:critical": "jest --runInBand --detectOpenHandles --testPathPatterns=\"healthRoutes|authTokenLogging|replayProtection|authRoutes|authenticateToken.integration|commandCrypto|authCookieSession\"",
    "report:unused-dependencies": "node scripts/governance/report-unused-dependencies.js",
    "migrate:rc47-indexes": "ts-node --transpile-only scripts/migrations/rc47-user-datas-partial-unique-indexes.ts"
  },
  "keywords": [
    "happy",
    "tts"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "@types/bcrypt": "^6.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/express-rate-limit": "^6.0.2",
    "@types/form-data": "^2.5.2",
    "@types/jsdom": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/uuid": "^11.0.0",
    "@types/validator": "^13.15.10",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "form-data": "^4.0.6",
    "google-auth-library": "^11.2.0",
    "helmet": "^8.3.0",
    "jsdom": "^30.1.2",
    "jsonwebtoken": "^9.0.3",
    "libsodium-wrappers": "^0.8.4",
    "lru-cache": "^11.5.3",
    "marked": "^18.1.0",
    "mongodb": "^7.7.0",
    "mongoose": "^9.11.1",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "openai": "^7.31.0",
    "proxy-addr": "^2.0.8",
    "qrcode": "^1.5.4",
    "react-syntax-highlighter": "^16.1.2",
    "redis": "^6.3.0",
    "resend": "^6.32.1",
    "socks-proxy-agent": "^10.1.0",
    "speakeasy": "^2.0.0",
    "ssh2": "^1.17.0",
    "svix": "^2.8.0",
    "swagger-jsdoc": "^6.3.0",
    "tar": "^7.5.22",
    "validator": "^13.15.35",
    "winston": "^3.19.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "^1.64.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/libsodium-wrappers": "^0.8.2",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/proxy-addr": "^2.0.3",
    "@types/qrcode": "^1.5.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/tar": "^7.0.87",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "fast-check": "^4.10.2",
    "javascript-obfuscator": "^5.9.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
