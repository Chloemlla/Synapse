{
  "name": "synapse-frontend",
  "private": true,
  "version": "26.9.1",
  "packageManager": "pnpm@11.11.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss",
    "*.sass",
    "*.less"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:vercel": "vite build --mode vercel",
    "typecheck": "tsc --noEmit",
    "build:simple": "tsc && vite build --mode simple",
    "build:minimal": "tsc && vite build --mode minimal",
    "build:analyze": "tsc && vite build --mode analyze",
    "build:optimized": "tsc && vite build --mode production",
    "preview": "vite preview",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "analyze": "npm run build:analyze && npx vite-bundle-analyzer dist"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fingerprintjs/fingerprintjs": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@microsoft/clarity": "^1.0.2",
    "@radix-ui/react-dialog": "^1.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/validator": "^13.15.10",
    "@vercel/analytics": "^2.0.1",
    "axios": "^1.20.0",
    "buffer": "^6.0.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "docx": "^9.9.0",
    "dompurify": "^3.4.16",
    "framer-motion": "^14.0.0",
    "html2canvas": "^1.4.1",
    "idb": "^8.0.4",
    "jspdf": "^4.2.1",
    "katex": "^0.19.0",
    "lucide-react": "^1.54.0",
    "marked": "^18.1.0",
    "marked-katex-extension": "^5.1.13",
    "md5": "^2.3.0",
    "mermaid": "^12.1.0",
    "prismjs": "^1.30.0",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "swagger-ui-react": "^5.33.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "util": "^0.12.5",
    "validator": "^13.15.35",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/marked": "^6.0.0",
    "@types/md5": "^2.3.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "javascript-obfuscator": "^5.9.0",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "tailwind-scrollbar": "^4.0.2",
    "tailwindcss": "^4.3.3",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-auto-i18n-plugin": "^1.1.16",
    "vitest": "^5.0.3"
  }
}
